<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ event.name }}</title>
<meta name="description" content="{{ event.catch or event.name }}">
<style>
  :root { --theme: {{ event.theme_color }}; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
         color: #333; background: #fff; line-height: 1.6; -webkit-text-size-adjust: 100%; }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 0 12px 60px; }

  /* ヒーロー */
  .hero { background: linear-gradient(135deg, var(--theme), color-mix(in srgb, var(--theme) 70%, #000));
          background-color: var(--theme); color: #fff; text-align: center; padding: 40px 16px 34px; }
  .hero h1 { font-size: 34px; letter-spacing: .04em; line-height: 1.3; }
  .hero .catch { margin-top: 10px; font-size: 16px; opacity: .95; }
  .hero .period { display: inline-block; margin-top: 16px; padding: 6px 20px;
                  border: 1px solid rgba(255,255,255,.8); border-radius: 999px; font-size: 14px; }

  /* セクションナビ */
  .secnav { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 20px 0 0; }
  .secnav a { padding: 8px 16px; border: 1px solid var(--theme); color: var(--theme);
              border-radius: 999px; font-size: 13px; font-weight: bold; }

  /* セクション */
  section { margin-top: 44px; }
  .sec-title { font-size: 22px; font-weight: bold; padding-left: 12px;
               border-left: 6px solid var(--theme); margin-bottom: 6px; }
  .sec-lead { font-size: 14px; color: #666; margin-bottom: 10px; }

  /* 商品グリッド */
  .item-grid { display: grid; gap: 14px; margin-top: 14px;
               grid-template-columns: repeat(3, 1fr); }
  .item-grid.cols2 { grid-template-columns: repeat(2, 1fr); }
  .item-grid.cols4 { grid-template-columns: repeat(4, 1fr); }
  .item-card { display: block; border: 1px solid #e5e5e5; border-radius: 8px;
               overflow: hidden; background: #fff; transition: box-shadow .15s; }
  .item-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,.12); }
  .item-img { display: block; aspect-ratio: 1 / 1; background: #f6f6f6; overflow: hidden; }
  .item-img img { width: 100%; height: 100%; object-fit: cover; }
  .item-noimg { display: flex; align-items: center; justify-content: center;
                height: 100%; color: #bbb; font-size: 12px; }
  .item-name { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
               overflow: hidden; font-size: 13px; padding: 8px 10px 0; min-height: 2.6em; }
  .item-price { display: block; padding: 4px 10px 2px; color: var(--theme);
                font-size: 17px; font-weight: bold; }
  .item-price small { font-size: 11px; color: #888; font-weight: normal; }
  .item-review { display: block; padding: 0 10px 10px; font-size: 11px; color: #666; }
  .stars { color: #f5a623; letter-spacing: 1px; }

  /* クーポン */
  .coupon-list { display: grid; gap: 14px; margin-top: 14px; grid-template-columns: repeat(2, 1fr); }
  .coupon-card { border: 2px dashed var(--theme); border-radius: 10px; padding: 18px 16px;
                 text-align: center; background: #fff;
                 background: color-mix(in srgb, var(--theme) 5%, #fff); }
  .coupon-label { font-size: 24px; font-weight: bold; color: var(--theme); }
  .coupon-desc { font-size: 13px; color: #666; margin-top: 4px; }
  .coupon-btn { display: inline-block; margin-top: 12px; padding: 12px 28px;
                background: var(--theme); color: #fff; border-radius: 999px;
                font-weight: bold; font-size: 15px; }

  /* ポイント変倍 */
  .point-banner { margin-top: 14px; padding: 22px; text-align: center; color: #fff;
                  background: var(--theme); border-radius: 10px; }
  .point-x { font-size: 22px; font-weight: bold; }
  .point-rate { font-size: 52px; font-weight: bold; margin: 0 4px; }

  /* フッター */
  .totop { display: block; margin: 50px auto 0; width: 220px; text-align: center;
           padding: 12px 0; border: 1px solid #ccc; border-radius: 999px; font-size: 13px; color: #666; }

  /* スマホ */
  @media (max-width: 640px) {
    .hero h1 { font-size: 24px; }
    .hero .catch { font-size: 14px; }
    .item-grid, .item-grid.cols2, .item-grid.cols4 { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .coupon-list { grid-template-columns: 1fr; }
    .sec-title { font-size: 19px; }
    .point-rate { font-size: 40px; }
  }
</style>
</head>
<body id="top">
<div class="hero">
  <h1>{{ event.name }}</h1>
  {% if event.catch %}<p class="catch">{{ event.catch }}</p>{% endif %}
  {% if event.start or event.end %}
  <span class="period">{{ event.start | fmt_dt }} 〜 {{ event.end | fmt_dt }}</span>
  {% endif %}
</div>
<div class="wrap">
  {% if sections | length >= 2 %}
  <nav class="secnav">
    {% for sec in sections %}<a href="#{{ sec.anchor }}">{{ sec.heading }}</a>{% endfor %}
  </nav>
  {% endif %}
  {% for sec in sections %}
  <section id="{{ sec.anchor }}">
    <h2 class="sec-title">{{ sec.heading }}</h2>
    {% include "sec_" ~ sec.type ~ ".html.j2" %}
  </section>
  {% endfor %}
  <a class="totop" href="#top">▲ ページトップに戻る</a>
</div>
</body>
</html>
